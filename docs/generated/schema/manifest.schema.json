{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "activation": {
      "additionalProperties": false,
      "description": "lazy activation triggers. When omitted, the plugin loads eagerly.",
      "properties": {
        "commands": {
          "description": "Command ids the plugin will register on activation. The host installs stubs for each so palette and keymap dispatch can activate the plugin.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "events": {
          "description": "Canonical event names. The host validates against the descriptor table.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "files": {
          "description": "Relative paths in the working tree whose presence triggers activation.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "keymaps": {
          "description": "(context, key) pairs. The host installs lazy keymap stubs.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "context": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "context",
              "key"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "manual": {
          "default": false,
          "description": "When true, the plugin only activates on explicit user action.",
          "type": "boolean"
        },
        "regions": {
          "description": "Region keys (`main_bar`, `tab_bar`, `repository`) whose first paint triggers activation.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repository_shape": {
          "additionalProperties": false,
          "description": "Boolean predicates over the active repository.",
          "properties": {
            "has_branch": {
              "type": "string"
            },
            "has_remote": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "api_version": {
      "description": "Stable plugin API version supported by this host.",
      "enum": [
        "1.0"
      ],
      "type": "string"
    },
    "capabilities": {
      "items": {
        "enum": [
          "fs:read",
          "fs:read:plugin",
          "fs:read:state",
          "fs:read:config",
          "fs:read:workdir",
          "fs:read:any",
          "fs:read:scope:<dir>",
          "fs:write:plugin",
          "fs:write:state",
          "fs:write:config",
          "fs:write:workdir",
          "fs:write:any",
          "fs:write:scope:<dir>",
          "process:spawn",
          "process:spawn:<binary>",
          "net:fetch",
          "net:fetch:<domain>",
          "clipboard",
          "clipboard:read",
          "clipboard:write",
          "notify",
          "env",
          "env:<glob>",
          "credentials",
          "repo:read",
          "git:read:status",
          "git:read:log",
          "git:read:diff",
          "git:read:show",
          "git:read:blame",
          "git:write:checkout",
          "git:write:branch",
          "git:write:tag",
          "git:write:commit",
          "git:write:stash",
          "git:write:reset",
          "git:write:fetch",
          "git:write:push",
          "git:write:merge",
          "git:write:rebase",
          "ui:region:<region>",
          "ui:replace:builtin",
          "ui:replace:<region>:<container>:<id>",
          "ui:remove:builtin",
          "ui:remove:<region>:<container>:<id>",
          "services:provide:<service@version>",
          "services:consume:<service@version>",
          "async:spawn",
          "timer:create",
          "fs:watch",
          "fs:watch:scope:<dir>",
          "ui:overlay",
          "ui:context_menu:<region>",
          "ui:chrome:<point>",
          "ui:decoration:graph",
          "ui:decoration:diff",
          "ui:screen",
          "ui:dock",
          "ui:status",
          "ui:style:raw_color"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "consumes_services": {
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]+@[0-9]+$",
        "type": "string"
      },
      "type": "array"
    },
    "dependencies": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "description": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "optional_dependencies": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "provides_services": {
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]+@[0-9]+$",
        "type": "string"
      },
      "type": "array"
    },
    "requires_plugins": {
      "description": "Other plugin ids whose `lua/<id>/` modules this plugin may `require`.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "runtime": {
      "additionalProperties": false,
      "description": "Per-plugin Lua runtime configuration.",
      "properties": {
        "strict_globals": {
          "default": true,
          "description": "When true (default), reads/writes of undeclared Lua globals raise.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "version": {
      "description": "SemVer plugin version.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "api_version"
  ],
  "title": "Git Leviathan plugin.toml",
  "type": "object"
}